@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <table class="table-light table-striped">
    <thead>
    <th scope="col">Season</th>
    <th scope="col">Correct Percent</th>
    </thead>
    <tbody>
    @foreach(Models.AveragedSpreadspoke averagedSpreadspoke in Model.AveragedSpreadSpokes)
    {
        <tr>
        <td>@averagedSpreadspoke.ScheduleSeason</td>
        <td>@(Math.Round(100*averagedSpreadspoke.SpreadCorrect,digits:0))%</td>
        </tr>
    }
    </tbody>
    </table>
</div>
